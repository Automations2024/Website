<?php
/**
 * Template Name: Blog Page
 * 
 * @package Arcturus
 */

get_header();
?>

<div class="breadcrumb-area shadow dark bg-cover text-center text-light" style="background-image: url(<?php echo esc_url( get_template_directory_uri() ); ?>/top/h/assets/img/acs/blog.jpg);">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 col-md-12">
                <h1>Blogs</h1>
            </div>
        </div>
    </div>
</div>
<!-- End Breadcrumb -->

<!-- Start Blog Area -->
<div class="blog-area full-blog blog-standard full-blog grid-colum default-padding">
    <div class="container">
        <div class="blog-items content-less">
            <div class="blog-content">
                <div class="blog-item-box">
                    <div class="row">
                        <?php
                        // Query blog posts
                        $args = array(
                            'post_type'      => 'post',
                            'posts_per_page' => 6,
                            'paged'          => max( 1, get_query_var( 'paged' ) ),
                        );
                        $query = new WP_Query( $args );

                        if ( $query->have_posts() ) :
                            while ( $query->have_posts() ) :
                                $query->the_post();
                                ?>
                                <!-- Single Blog Item -->
                                <div class="col-lg-6 col-md-6 single-item">
                                    <div class="item">
                                        <div class="thumb blog_img">
                                            <a href="<?php the_permalink(); ?>">
                                                <?php
                                                if ( has_post_thumbnail() ) {
                                                    the_post_thumbnail( 'full', array( 'class' => 'h-100' ) );
                                                } else {
                                                    echo '<img class="h-100" src="' . esc_url( get_template_directory_uri() ) . '/top/h/assets/img/placeholder.jpg" alt="' . esc_attr( get_the_title() ) . '">';
                                                }
                                                ?>
                                            </a>
                                            <div class="date">
                                                <strong><?php echo get_the_date( 'd' ); ?></strong>
                                                <span><?php echo get_the_date( 'M' ); ?></span>
                                            </div>
                                        </div>
                                        <div class="info">
                                            <h4 class="blog__title">
                                                <a href="<?php the_permalink(); ?>"><?php the_title(); ?></a>
                                            </h4>
                                            <p><?php echo wp_trim_words( get_the_excerpt(), 20 ); ?></p>
                                            <a class="btn circle btn-theme-border btn-sm" href="<?php the_permalink(); ?>">Read More</a>
                                        </div>
                                    </div>
                                </div>
                                <?php
                            endwhile;
                        else :
                            echo '<p>No blogs found.</p>';
                        endif;
                        wp_reset_postdata();
                        ?>
                    </div>

                    <!-- Pagination -->
                    <div class="row">
                        <div class="col-md-12 pagi-area text-center">
                            <nav aria-label="navigation">
                                <ul class="pagination">
                                    <?php
                                    // Previous page link
                                    if ( $query->query_vars['paged'] > 1 ) {
                                        echo '<li class="page-item"><a class="page-link" href="' . esc_url( get_pagenum_link( 1 ) ) . '"><i class="fas fa-angle-double-left"></i></a></li>';
                                    }

                                    // Numbered pagination
                                    for ( $i = 1; $i <= $query->max_num_pages; $i++ ) {
                                        $active = ( $i === $query->query_vars['paged'] || ( ! isset( $query->query_vars['paged'] ) && $i === 1 ) ) ? 'active' : '';
                                        echo '<li class="page-item ' . esc_attr( $active ) . '"><a class="page-link" href="' . esc_url( get_pagenum_link( $i ) ) . '">' . esc_html( $i ) . '</a></li>';
                                    }

                                    // Next page link
                                    if ( $query->query_vars['paged'] < $query->max_num_pages ) {
                                        echo '<li class="page-item"><a class="page-link" href="' . esc_url( get_pagenum_link( $query->max_num_pages ) ) . '"><i class="fas fa-angle-double-right"></i></a></li>';
                                    }
                                    ?>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- End Blog -->

<?php get_footer(); ?>
