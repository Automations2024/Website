<script>
jQuery(function($){
    // COUNTER: requires jquery.appear.js + jquery.countTo.js
    if ($.fn.appear && $.fn.countTo) {
        $('.timer').each(function () {
            var $this = $(this);
            $this.appear(function() {
                if ($this.data('counted')) return;
                $this.data('counted', true);
                $this.addClass('counting');
                $this.countTo({
                    from: 0,
                    to: $this.data('to'),
                    speed: $this.data('speed') || 2000,
                    refreshInterval: 50,
                    onComplete: function() {
                        $this.removeClass('counting');
                    }
                });
            });
        });
    } else {
        console.warn('appear or countTo plugin not loaded');
    }
});
</script>

